import rtconfig
from building import *

# get current directory
cwd = GetCurrentDir()

# The set of source files associated with this SConscript file.

src = Split('''
GD32E11x_standard_peripheral/Source/gd32e11x_gpio.c
GD32E11x_standard_peripheral/Source/gd32e11x_rcu.c
GD32E11x_standard_peripheral/Source/gd32e11x_exti.c
GD32E11x_standard_peripheral/Source/gd32e11x_misc.c
GD32E11x_standard_peripheral/Source/gd32e11x_pmu.c
''')

if GetDepend(['RT_USING_SERIAL']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_usart.c']

if GetDepend(['RT_USING_I2C']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_i2c.c']

if GetDepend(['RT_USING_SPI']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_spi.c']

if GetDepend(['RT_USING_ADC']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_adc.c']

if GetDepend(['RT_USING_DAC']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_dac.c']

if GetDepend(['RT_USING_RTC']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_rtc.c']

if GetDepend(['RT_USING_WDT']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_wwdgt.c']
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_fwdgt.c']

if GetDepend(['RT_USING_DMA']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_dma.c']

if GetDepend(['RT_USING_HWTIMER', 'RT_USING_PWM']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_timer.c']

if GetDepend(['BSP_USING_FMC']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_fmc.c']

if GetDepend(['BSP_USING_EXMC']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_exmc.c']

if GetDepend(['BSP_USING_CTC']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_ctc.c']

if GetDepend(['BSP_USING_BKP']):
    src += ['GD32E11x_standard_peripheral/Source/gd32e11x_bkp.c']

path = [cwd + '/GD32E11x_standard_peripheral/Include']

CPPDEFINES = ['USE_STDPERIPH_DRIVER', 'GD32E113']

group = DefineGroup('Libraries', src, depend = ['SOC_SERIES_GD32E11x'], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')

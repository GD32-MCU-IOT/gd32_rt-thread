import rtconfig
from building import *

# get current directory
cwd = GetCurrentDir()

# The set of source files associated with this SConscript file.
src = Split('''
GD/GD32G5x3/Source/system_gd32g5x3.c
''')

path = [
    cwd + '/GD/GD32G5x3/Include',
    ]
if rtconfig.PLATFORM == 'gcc':
    path += [cwd]

if rtconfig.PLATFORM in ['gcc']:
    src += ['GD/GD32G5x3/Source/GCC/startup_gd32g5x3.S']
elif rtconfig.PLATFORM in ['armcc', 'armclang']:
    src += ['GD/GD32G5x3/Source/ARM/startup_gd32g5x3.s']
elif rtconfig.PLATFORM in ['iccarm']:
    src += ['GD/GD32G5x3/Source/IAR/startup_gd32g5x3.s']

CPPDEFINES = ['USE_STDPERIPH_DRIVER']

group = DefineGroup('Libraries', src, depend = ['SOC_SERIES_GD32G5x3'], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')

                default n

            config BSP_USING_SPI5
                bool "Enable SPI5 BUS"
                default n

            config BSP_SPI5_USING_DMA
                bool "Enable SPI5 DMA"
                depends on BSP_USING_SPI5
                select BSP_USING_SPI_DMA
                default n

            if BSP_USING_SPI_DMA
                config BSP_SPI_DMA_TRANS_MIN_LEN
                    int "SPI DMA minimum transfer length"
                    range 4 65535
                    default 16
                    help
                        Transfers smaller than this will use polling mode.
                        DMA mode is used when buffer length is greater than or equal to this value.
            endif
        endif

    menuconfig BSP_USING_I2C
        bool "Enable I2C BUS"
        default n
        select RT_USING_I2C
        if BSP_USING_I2C
            config BSP_USING_I2C_TX_DMA
                bool

            config BSP_USING_I2C_RX_DMA
                bool

            config BSP_USING_HARD_I2C0
                bool "Enable I2C0 BUS"
                default n

            config BSP_I2C0_TX_USING_DMA
                bool "Enable I2C0 TX DMA"
                depends on BSP_USING_HARD_I2C0
                select BSP_USING_I2C_TX_DMA
                default n

            config BSP_I2C0_RX_USING_DMA
                bool "Enable I2C0 RX DMA"
                depends on BSP_USING_HARD_I2C0
                select BSP_USING_I2C_RX_DMA
                default n

            config BSP_USING_HARD_I2C1
                bool "Enable I2C1 BUS"
                default n

            config BSP_I2C1_TX_USING_DMA
                bool "Enable I2C1 TX DMA"
                depends on BSP_USING_HARD_I2C1
                select BSP_USING_I2C_TX_DMA
                default n

            config BSP_I2C1_RX_USING_DMA
                bool "Enable I2C1 RX DMA"
                depends on BSP_USING_HARD_I2C1
                select BSP_USING_I2C_RX_DMA
                default n

            config BSP_USING_HARD_I2C2
                bool "Enable I2C2 BUS"
                default n

            config BSP_I2C2_TX_USING_DMA
                bool "Enable I2C2 TX DMA"
                depends on BSP_USING_HARD_I2C2
                select BSP_USING_I2C_TX_DMA
                default n

            config BSP_I2C2_RX_USING_DMA
                bool "Enable I2C2 RX DMA"
                depends on BSP_USING_HARD_I2C2
                select BSP_USING_I2C_RX_DMA
                default n

            config BSP_USING_HARD_I2C3
                bool "Enable I2C3 BUS (New I2C)"
                default n
                help
                    I2C3 is a new I2C peripheral that supports both TX and RX DMA

            config BSP_I2C3_TX_USING_DMA
                bool "Enable I2C3 TX DMA"
                depends on BSP_USING_HARD_I2C3
                select BSP_USING_I2C_TX_DMA
                default n

            config BSP_I2C3_RX_USING_DMA
                bool "Enable I2C3 RX DMA"
                depends on BSP_USING_HARD_I2C3
                select BSP_USING_I2C_RX_DMA
                default n

            config BSP_USING_HARD_I2C4
                bool "Enable I2C4 BUS (New I2C)"
                default n
                help
                    I2C4 is a new I2C peripheral that supports both TX and RX DMA

            config BSP_I2C4_TX_USING_DMA
                bool "Enable I2C4 TX DMA"
                depends on BSP_USING_HARD_I2C4
                select BSP_USING_I2C_TX_DMA
                default n

            config BSP_I2C4_RX_USING_DMA
                bool "Enable I2C4 RX DMA"
                depends on BSP_USING_HARD_I2C4
                select BSP_USING_I2C_RX_DMA
                default n

            config BSP_USING_HARD_I2C5
                bool "Enable I2C5 BUS (New I2C)"
                default n
                help
                    I2C5 is a new I2C peripheral that supports both TX and RX DMA

            config BSP_I2C5_TX_USING_DMA
                bool "Enable I2C5 TX DMA"
                depends on BSP_USING_HARD_I2C5
                select BSP_USING_I2C_TX_DMA
                default n

            config BSP_I2C5_RX_USING_DMA
                bool "Enable I2C5 RX DMA"
                depends on BSP_USING_HARD_I2C5
                select BSP_USING_I2C_RX_DMA
                default n

            if BSP_USING_I2C_TX_DMA || BSP_USING_I2C_RX_DMA
                config BSP_I2C_DMA_TRANS_MIN_LEN
                    int "I2C DMA minimum transfer length"
                    range 1 256
                    default 8
                    help
                        Transfers smaller than this will use polling mode.
                        DMA mode is used when buffer length is greater than or equal to this value.

                config BSP_I2C_DMA_TIMEOUT
                    int "I2C DMA transfer timeout (ms)"
                    range 1 60000
                    default 1000
                    help
                        Maximum wait time for an I2C DMA transfer to complete.
                        The driver reports a timeout once this limit is reached.
            endif
        endif


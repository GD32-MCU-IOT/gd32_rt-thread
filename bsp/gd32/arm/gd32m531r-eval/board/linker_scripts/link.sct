; *************************************************************
; *** Scatter-Loading Description File for GD32M531R ***
; *** ARM Compiler 6 Compatible Version ***
; *************************************************************

LR_IROM1 0x08000000 0x00040000  {    ; load region size_region (256KB)
  ER_IROM1 0x08000000 0x00040000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00008000  {  ; RW data (32KB)
   .ANY (+RW +ZI)
  }
}
import rtconfig
from building import *

# get current directory
cwd = GetCurrentDir()

# The set of source files associated with this SConscript file.

src = Split('''
GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_gpio.c
GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_rcu.c
GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_dma.c
GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_exti.c
GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_misc.c
GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_syscfg.c
''')

if GetDepend(['RT_USING_SERIAL']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_usart.c']

if GetDepend(['RT_USING_I2C']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_i2c.c']

if GetDepend(['RT_USING_SPI']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_spi.c']

if GetDepend(['RT_USING_PWM']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_timer.c']

if GetDepend(['RT_USING_WDT']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_wwdgt.c']
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_fwdgt.c']

if GetDepend(['RT_USING_RTC']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_rtc.c']
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_pmu.c']

if GetDepend(['RT_USING_SDIO']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_sdio.c']

if GetDepend(['BSP_USING_GD_DBG']):
    src += ['GD32W51x_F5HC_standard_peripheral/Source/gd32w51x_f5hc_dbg.c']

path = [cwd + '/GD32W51x_F5HC_standard_peripheral/Include']

CPPDEFINES = ['USE_STDPERIPH_DRIVER']

group = DefineGroup('Libraries', src, depend = ['SOC_GD32F5HC'], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')

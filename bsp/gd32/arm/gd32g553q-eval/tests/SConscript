# -*- coding: utf-8 -*-
# SConscript for DMA Test Suite Integration
# 
# Usage in main SConscript:
#   if GetDepend('BSP_USING_DMA_TEST'):
#       src += Glob('tests/*.c')

from building import *

cwd = GetCurrentDir()
group = []

# Get common flags
CPPDEFINES = ''
CCFLAGS = ''

# DMA Test Suite
if GetDepend('BSP_USING_DMA_TEST'):
    src = Glob('*.c')
    path = [cwd]
    
    group = DefineGroup('DMA Tests', src, depend=['BSP_USING_DMA_TEST'], 
                        CPPPATH=path, CPPDEFINES=CPPDEFINES, CCFLAGS=CCFLAGS)

Return('group')

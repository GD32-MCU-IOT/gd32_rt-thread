import rtconfig
from building import *

# get current directory
cwd = GetCurrentDir()

# The set of source files associated with this SConscript file.
src = Split('''
GD/GD32W51x_F5HC/Source/system_gd32w51x_f5hc.c
''')

path = [
    cwd + '/GD/GD32W51x_F5HC/Include',
    cwd,
]

if rtconfig.PLATFORM in ['gcc']:
    src += ['GD/GD32W51x_F5HC/Source/GCC/startup_gd32f5hc.S']
elif rtconfig.PLATFORM in ['armcc', 'armclang']:
    src += ['GD/GD32W51x_F5HC/Source/ARM/startup_gd32f5hc.s']
elif rtconfig.PLATFORM in ['iccarm']:
    src += ['GD/GD32W51x_F5HC/Source/IAR/startup_gd32f5hc.s']

CPPDEFINES = ['USE_STDPERIPH_DRIVER', 'SYS_NS']

group = DefineGroup('Libraries', src, depend = ['SOC_GD32F5HC'], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')

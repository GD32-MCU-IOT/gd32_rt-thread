; *************************************************************
; *** Scatter-Loading Description File for GD32F503V ***
; *** ARM Compiler 6 Compatible Version ***
; *************************************************************

LR_IROM1 0x08000000 0x00080000  {    ; load region size_region (512KB)
  ER_IROM1 0x08000000 0x00080000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; RW data (128KB)
   .ANY (+RW +ZI)
  }
}
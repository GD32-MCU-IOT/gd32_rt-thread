import rtconfig
from building import *

# get current directory
cwd = GetCurrentDir()

# The set of source files associated with this SConscript file.
src = Split('''
GD/GD32E11x/Source/system_gd32e11x.c
''')

path = [
    cwd + '/GD/GD32E11x/Include',
]
if rtconfig.PLATFORM == 'gcc':
    path += [cwd]

if rtconfig.PLATFORM in ['gcc']:
    src += ['GD/GD32E11x/Source/GCC/startup_gd32e11x.S']
elif rtconfig.PLATFORM in ['armcc', 'armclang']:
    src += ['GD/GD32E11x/Source/ARM/startup_gd32e11x.s']
elif rtconfig.PLATFORM in ['iccarm']:
    src += ['GD/GD32E11x/Source/IAR/startup_gd32e11x.s']

CPPDEFINES = ['USE_STDPERIPH_DRIVER']

group = DefineGroup('Libraries', src, depend = ['SOC_SERIES_GD32E11x'], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')
